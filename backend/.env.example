# ============================================================
# Konfigurasi lingkungan backend desa citapen (contoh)
# Salin file ini menjadi .env lalu isi nilai yang sebenarnya.
# JANGAN PERNAH commit file .env ke git.
# ============================================================

# Port tempat server berjalan
PORT=3000

# URL koneksi database postgresql (untuk supabase ganti dengan
# connection string dari dashboard supabase)
DATABASE_URL=postgresql://hafizhtux:1234567890@localhost:5432/desa_citapen

# ---------- Konfigurasi SSL manual untuk Supabase ----------
# WAJIB diatur saat pakai Supabase (Render/Vercel -> Supabase pooler 6543).
# - true  : pakai SSL { rejectUnauthorized: false } (wajib untuk Supabase)
# - false : tanpa SSL (untuk lokal homebrew tanpa SSL)
# - kosong/tidak diatur : otomatis aktif jika DATABASE_URL mengandung 'supabase' atau 'sslmode=require'
# Contoh Supabase pooler (Supavisor):
#   DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Contoh Supabase direct:
#   DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Rekomendasi:
#   - Lokal (homebrew)      => DATABASE_SSL=false  atau kosongkan (otomatis tanpa SSL)
#   - Produksi (Supabase)   => DATABASE_SSL=true
DATABASE_SSL=false

# Rahasia untuk menandatangani token jwt (wajib panjang dan acak,
# minimal 32 karakter di produksi)
JWT_RAHASIA=ganti_dengan_rahasia_acak_panjang_minimal_32_karakter

# Masa berlaku token (contoh: 1d, 2h, 30m)
JWT_KEDALUWARSA=1d

# Daftar asal (origin) yang diizinkan mengakses api, pisahkan dengan koma.
# Contoh untuk vercel: https://desa-citapen.vercel.app
# Kosongkan atau isi * untuk mengizinkan semua asal (hanya untuk pengembangan)
ASAL_DIIZINKAN=*

# Kredensial admin awal yang otomatis dibuat saat server pertama kali
# dijalankan (hanya dibuat jika belum ada admin sama sekali)
USERNAME_ADMIN_AWAL=admin
SANDI_ADMIN_AWAL=AdminDesa123

# Tingkat log: trace, debug, info, warn, error
LOG_TINGKAT=info

# ---------- Drizzle ORM (sudah terpasang: drizzle-orm + drizzle-kit) ----------
# Skema Drizzle ada di src/db/schema.ts (9 tabel) dan dikonfigurasi di drizzle.config.ts
# Pool tetap memakai pg Pool yang sama dengan SSL manual di atas (src/config/database.ts).
# Perintah Drizzle Kit:
#   npm run db:generate  # buat file migrasi SQL di ./drizzle dari perubahan schema.ts
#   npm run db:push       # push schema langsung ke DB (cocok untuk Supabase, tanpa buat file)
#   npm run db:studio     # buka Drizzle Studio GUI (butuh DATABASE_URL & DATABASE_SSL)
#   npm run db:migrate    # jalankan migrasi yang ada di ./drizzle
# Catatan Supabase:
#   - Untuk pooler 6543, pastikan DATABASE_SSL=true agar drizzle-kit juga pakai SSL
#   - drizzle.config.ts sudah otomatis deteksi supabase / sslmode=require jika DATABASE_SSL kosong

# ---------- Pembatasan laju permintaan (anti brute force) ----------
# Batas permintaan umum per ip dalam 15 menit
BATAS_LAJU_UMUM=300
# Batas permintaan ke endpoint autentikasi (login) per ip dalam 15 menit
BATAS_LAJU_LOGIN=30
# Batas permintaan unggah berkas per ip dalam 15 menit
BATAS_LAJU_UNGGAH=60

# ---------- Penyimpanan berkas (WAJIB untuk Vercel) ----------
# Vercel filesystem bersifat ephemeral (/tmp hilang tiap cold start).
# Untuk produksi Vercel + Supabase, WAJIB isi SUPABASE_URL & key agar gambar persisten.
# Jika tidak diisi, backend fallback ke filesystem lokal (cocok untuk dev/lokal/Render).
#
# Cara mengisi (dapati di dashboard Supabase -> Project Settings -> API):
# - SUPABASE_URL=https://xxxxxxxx.supabase.co
# - SUPABASE_SERVICE_ROLE_KEY=eyJhbGc... (service_role, bukan anon) -> copy dari Settings -> API -> service_role (legacy) / Secret key
#   Alternatif: SUPABASE_ANON_KEY jika bucket sudah public dan policy mengizinkan.
# - SUPABASE_STORAGE_BUCKET=unggahan (nama bucket, default unggahan)
#
# Langkah setup Supabase Storage (sekali saja):
# 1. Buka Supabase Dashboard -> Storage -> New bucket -> nama "unggahan", set Public = ON
# 2. Atau biarkan backend otomatis buat bucket saat pertama start (butuh service_role).
# 3. Pastikan policy public read aktif (default jika public=ON).
#    SQL verifikasi:
#    SELECT * FROM storage.buckets WHERE name='unggahan';
#
# Lokal/dev tanpa Supabase: kosongkan saja SUPABASE_URL, maka file disimpan di ./unggahan
# Produksi Vercel: WAJIB isi SUPABASE_URL + SERVICE_ROLE_KEY agar upload tidak hilang
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=unggahan
