# ============================================================
# Konfigurasi lingkungan backend desa citapen (contoh)
# Salin file ini menjadi .env lalu isi nilai yang sebenarnya.
# JANGAN PERNAH commit file .env ke git.
# ============================================================

# Port tempat server berjalan
PORT=3000

# URL koneksi database postgresql (untuk supabase ganti dengan
# connection string dari dashboard supabase)
DATABASE_URL=postgresql://hafizhtux:1234567890@localhost:5432/desa_citapen

# Rahasia untuk menandatangani token jwt (wajib panjang dan acak,
# minimal 32 karakter di produksi)
JWT_RAHASIA=ganti_dengan_rahasia_acak_panjang_minimal_32_karakter

# Masa berlaku token (contoh: 1d, 2h, 30m)
JWT_KEDALUWARSA=1d

# Daftar asal (origin) yang diizinkan mengakses api, pisahkan dengan koma.
# Contoh untuk vercel: https://desa-citapen.vercel.app
# Kosongkan atau isi * untuk mengizinkan semua asal (hanya untuk pengembangan)
ASAL_DIIZINKAN=*

# Kredensial admin awal yang otomatis dibuat saat server pertama kali
# dijalankan (hanya dibuat jika belum ada admin sama sekali)
USERNAME_ADMIN_AWAL=admin
SANDI_ADMIN_AWAL=AdminDesa123

# Tingkat log: trace, debug, info, warn, error
LOG_TINGKAT=info

# ---------- Pembatasan laju permintaan (anti brute force) ----------
# Batas permintaan umum per ip dalam 15 menit
BATAS_LAJU_UMUM=300
# Batas permintaan ke endpoint autentikasi (login) per ip dalam 15 menit
BATAS_LAJU_LOGIN=30
# Batas permintaan unggah berkas per ip dalam 15 menit
BATAS_LAJU_UNGGAH=60
