{
  "name": "backend-desa-citapen",
  "version": "1.0.0",
  "description": "Layanan web (web service) profil desa citapen dan katalog produk umkm",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/obfuscate.mjs",
    "build:asli": "tsc -p tsconfig.json",
    "build:obfuscate": "node scripts/obfuscate.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run src/pengujian/unit",
    "test:integrasi": "vitest run src/pengujian/integrasi",
    "test:api": "vitest run src/pengujian/api",
    "test:keamanan": "vitest run src/pengujian/keamanan",
    "test:aksesibilitas": "vitest run src/pengujian/aksesibilitas",
    "test:sanity": "vitest run src/pengujian/sanity",
    "test:regresi": "vitest run src/pengujian/regresi",
    "test:asap": "vitest run src/pengujian/asap",
    "test:beban": "node src/pengujian/beban/pengujian-beban.mjs",
    "test:kinerja": "node src/pengujian/kinerja/pengujian-kinerja.mjs",
    "test:stress": "node src/pengujian/stress/pengujian-stress.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "autocannon": "^7.15.0",
    "glob": "^13.0.6",
    "javascript-obfuscator": "^5.6.0",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
